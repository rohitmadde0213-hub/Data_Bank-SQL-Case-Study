#total allocation

WITH base_txns AS (
    -- Step 1: Standardize transaction amounts (Deposits = positive, Withdrawals/Purchases = negative)
    SELECT 
        customer_id,
        txn_date,
        EXTRACT(MONTH FROM txn_date) AS txn_month,
        CASE 
            WHEN txn_type = 'deposit' THEN txn_amount 
            ELSE -txn_amount 
        END AS net_txn_amount
    FROM customer_transactions
),
running_balances AS (
    -- Step 2: Calculate real-time transaction-level running balance per customer
    SELECT 
        customer_id,
        txn_date,
        txn_month,
        SUM(net_txn_amount) OVER (
            PARTITION BY customer_id 
            ORDER BY txn_date
        ) AS running_balance
    FROM base_txns
),
option3_monthly AS (
    -- OPTION 3: Real-Time Balance (Sum of running balances per month)
    SELECT 
        txn_month,
        SUM(running_balance) AS total_option3_allocation
    FROM running_balances
    GROUP BY txn_month
),
option2_monthly AS (
    -- OPTION 2: 30-Day / Monthly Average Balance per customer, then summed globally
    SELECT 
        txn_month,
        ROUND(SUM(avg_monthly_balance), 2) AS total_option2_allocation
    FROM (
        SELECT 
            customer_id,
            txn_month,
            AVG(running_balance) AS avg_monthly_balance
        FROM running_balances
        GROUP BY customer_id, txn_month
    ) AS cust_avg
    GROUP BY txn_month
),
monthly_net AS (
    -- Helper for Option 1: Sum net transactions per customer per month
    SELECT 
        customer_id,
        txn_month,
        SUM(net_txn_amount) AS net_amount
    FROM base_txns
    GROUP BY customer_id, txn_month
),
monthly_closing AS (
    -- Helper for Option 1: Rolling monthly closing balance per customer
    SELECT 
        customer_id,
        txn_month,
        SUM(net_amount) OVER (
            PARTITION BY customer_id 
            ORDER BY txn_month
        ) AS closing_balance
    FROM monthly_net
),
previous_month_balance AS (
    -- Helper for Option 1: Pull prior month's closing balance using LAG()
    SELECT 
        customer_id,
        txn_month,
        LAG(closing_balance) OVER (
            PARTITION BY customer_id 
            ORDER BY txn_month
        ) AS prev_month_balance
    FROM monthly_closing
),
option1_monthly AS (
    -- OPTION 1: Previous Month-End Balance sum per month
    SELECT 
        txn_month,
        SUM(COALESCE(prev_month_balance, 0)) AS total_option1_allocation
    FROM previous_month_balance
    GROUP BY txn_month
)
-- FINAL OUTPUT: Combine all three options side-by-side by month for Tableau
SELECT 
    m.txn_month,
    COALESCE(o1.total_option1_allocation, 0) AS total_option1_allocation,
    COALESCE(o2.total_option2_allocation, 0) AS total_option2_allocation,
    COALESCE(o3.total_option3_allocation, 0) AS total_option3_allocation
FROM (
    SELECT DISTINCT txn_month FROM base_txns
) m
LEFT JOIN option1_monthly o1 ON m.txn_month = o1.txn_month
LEFT JOIN option2_monthly o2 ON m.txn_month = o2.txn_month
LEFT JOIN option3_monthly o3 ON m.txn_month = o3.txn_month
ORDER BY m.txn_month;



